# The cloud entry's key. Leave it empty and enter it on the Settings page instead if you like:
# the page writes it to this line (or to FINQUERY_KEY_FILE, when that points elsewhere).
OPENROUTER_API_KEY=
FINQUERY_PROVIDER=openrouter
# Tokens one turn may fill. Lower it to see context compression sooner.
# FINQUERY_CONTEXT_BUDGET=32768
# The hosted sub-agent slot: what a role set to `fast` runs on in the cloud. The hosted chat
# entry (Gemma 4 26B A4B) is the catalog's own and is always offered.
# FINQUERY_OPENROUTER_FAST_MODEL=google/gemma-4-26b-a4b-it
# Which model each sub-agent role runs on: `chat` (the conversation's own entry, the default),
# `fast` (the slot above, or the Gemma 4 E4B entry locally) or a catalog key. The query and
# chart adapters attach whenever those two roles land on E4B, whatever put them there.
# FINQUERY_SUBAGENT_MODEL_QUERY=chat
# FINQUERY_SUBAGENT_MODEL_CHART=chat
# FINQUERY_SUBAGENT_MODEL_CATEGORIZER=chat
# FINQUERY_SUBAGENT_MODEL_EXTRACTION=chat
# FINQUERY_SUBAGENT_MODEL_MEMORY=chat
# FINQUERY_SUBAGENT_MODEL_SUMMARY=chat
# FINQUERY_SUBAGENT_MODEL_WEBLOOKUP=chat
# Local provider only:
# FINQUERY_MODELS_DIR=models
# FINQUERY_PARKED_MODELS_DIR=
# FINQUERY_LOCAL_N_CTX=32768
