    {
      "id": "41-cumulative-halves-en",
      "set": "chart",
      "kind": "area",
      "difficulty": 3,
      "language": "en",
      "question": "Compare how my spending added up over the first half of 2025 and over the second half.",
      "seconds": 7.97,
      "figure_match": true,
      "sql_valid": true,
      "first_attempt": true,
      "attempts": 1,
      "sql": "WITH monthly_spending AS (\n  SELECT\n    CASE\n      WHEN CAST(STRFTIME('%m', booked_on) AS INTEGER) <= 6\n      THEN 'First half'\n      ELSE 'Second half'\n    END AS half,\n    CASE\n      WHEN CAST(STRFTIME('%m', booked_on) AS INTEGER) <= 6\n      THEN CAST(CAST(STRFTIME('%m', booked_on) AS INTEGER) AS TEXT)\n      ELSE CAST(CAST(STRFTIME('%m', booked_on) AS INTEGER) - 6 AS TEXT)\n    END AS month_of_half,\n    -SUM(amount) AS monthly_eur\n  FROM transaction_view\n  WHERE\n    amount < 0 AND booked_on BETWEEN '2025-01-01' AND '2025-12-31'\n  GROUP BY\n    half,\n    month_of_half\n)\nSELECT\n  month_of_half,\n  half,\n  ROUND(\n    SUM(monthly_eur) OVER (PARTITION BY half ORDER BY CAST(month_of_half AS INTEGER)),\n    2\n  ) AS cumulative_eur\nFROM monthly_spending\nORDER BY\n  half,\n  CAST(month_of_half AS INTEGER)\nLIMIT 200",
