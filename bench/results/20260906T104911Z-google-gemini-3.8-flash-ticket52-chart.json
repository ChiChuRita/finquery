      "sql_valid": true,
      "first_attempt": true,
      "attempts": 1,
      "sql": "WITH top_categories AS (\n  SELECT\n    COALESCE(category, 'Needs review') AS topic\n  FROM transaction_view\n  WHERE\n    amount < 0 AND booked_on BETWEEN '2025-11-01' AND '2025-12-31'\n  GROUP BY\n    topic\n  ORDER BY\n    -SUM(amount) DESC\n  LIMIT 6\n)\nSELECT\n  COALESCE(category, 'Needs review') AS topic,\n  CASE\n    WHEN booked_on BETWEEN '2025-12-01' AND '2025-12-31'\n    THEN 'This month'\n    ELSE 'Last month'\n  END AS period,\n  ROUND(-SUM(amount), 2) AS total_eur\nFROM transaction_view\nWHERE\n  amount < 0\n  AND booked_on BETWEEN '2025-11-01' AND '2025-12-31'\n  AND COALESCE(category, 'Needs review') IN (\n    SELECT\n      topic\n    FROM top_categories\n  )\nGROUP BY\n  topic,\n  period\nORDER BY\n  topic,\n  period DESC\nLIMIT 200",
