      "question": "Compare my spending on Dining between Q1 and Q2 2025.",
      "seconds": 25.48,
      "figure_match": true,
      "sql_valid": true,
      "first_attempt": false,
      "attempts": 2,
      "sql": "SELECT\n  CASE\n    WHEN booked_on BETWEEN '2025-01-01' AND '2025-03-31'\n    THEN 'Q1 2025'\n    ELSE 'Q2 2025'\n  END AS period,\n  ROUND(-SUM(amount), 2) AS total_eur\nFROM transaction_view\nWHERE\n  amount < 0\n  AND category = 'Dining'\n  AND booked_on BETWEEN '2025-01-01' AND '2025-06-30'\nGROUP BY\n  period\nORDER BY\n  period\nLIMIT 200",
