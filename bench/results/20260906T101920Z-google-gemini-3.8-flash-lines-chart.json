      "sql": "SELECT\n  STRFTIME('%Y', booked_on) || '-Q' || (\n    (\n      CAST(STRFTIME('%m', booked_on) AS INTEGER) + 2\n    ) / 3\n  ) AS quarter,\n  ROUND(-SUM(amount), 2) AS total_eur\nFROM transaction_view\nWHERE\n  amount < 0\n  AND category = 'Transport'\n  AND booked_on BETWEEN '2025-01-01' AND '2025-12-31'\nGROUP BY\n  quarter\nORDER BY\n  quarter ASC\nLIMIT 200",
